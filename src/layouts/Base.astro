---
import '../styles/global.css';

const {
  title,
  description,
  image = '/img/bolide.jpg',
  type = 'website',
  published,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Supercars Passion" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@max_speedster1" />
  {published && <meta property="article:published_time" content={published} />}

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Supercars Passion" href="/rss.xml" />
  <link rel="preload" href="/fonts/fraunces-300-900.woff2" as="font" type="font/woff2" crossorigin />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Cloudflare Web Analytics. No cookies, so no consent banner.
       is:inline keeps Astro from bundling it, and it loads as a classic
       deferred script rather than a module: the beacon reads its token from
       document.currentScript, which is null inside an ES module. -->
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "3c113d1f48d54cc89dd11f4a24a6f805"}'></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site">
    <div class="wrap mast">
      <a href="/" class="mark">Supercars <em>Passion</em></a>
      <nav>
        <a href="/">Hypercars</a>
        <a href="/">Coachbuilt</a>
        <a href="/">Endurance</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <div class="plate"><span class="lead">EST</span><span>2023</span></div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site">
    <div class="wrap foot">
      <div>Supercars Passion — hypercars, coachbuilt, endurance<br />&copy; {year}</div>
      <div>The Wire links to the original publisher.<br />Photography under Creative Commons, credited per image.</div>
      <div><a href="/privacy/">Privacy &amp; Cookies</a><br />No cookies. No tracking.</div>
    </div>
  </footer>
</body>
</html>
